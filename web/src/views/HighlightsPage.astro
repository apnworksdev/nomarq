---
import HomeSection from '../components/HomeSection.astro';
import { getHomeSectionHref, getHomeSectionItem } from '../lib/home';
import { HOME_SCROLL_RESTORE_KEY } from '../lib/home-scroll';
import { defaultLocale, type Locale } from '../lib/i18n';
import { getLocalizedPath } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import { homeQuery, type HomeDocument } from '../lib/queries';
import { sanity } from '../lib/sanity';
import '../styles/pages/home.css';
import '../styles/components/entry-caption.css';
import '../styles/components/entry-gallery.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const home = await sanity.fetch<HomeDocument | null>(homeQuery, {
  language: locale,
  defaultLanguage: defaultLocale,
});
const sections = (home?.sections ?? []).filter((section) => getHomeSectionItem(section));
---

<Layout title="Nomarq" page="home">
  {
    sections.length === 0 ? (
      <p class="home-empty">No home sections yet. Add some in Sanity Studio.</p>
    ) : (
      <>
        <nav
          class="home-section-nav"
          aria-label={locale === 'es' ? 'Secciones destacadas' : 'Highlight sections'}
        >
          <ol class="home-section-nav-list">
            {
              sections.map((_, index) => (
                <li>
                  <button
                    type="button"
                    class:list={['home-section-nav-item', 'active-parens', { 'is-active': index === 0 }]}
                    data-home-section-nav={index}
                    aria-current={index === 0 ? 'true' : 'false'}
                  >
                    {index + 1}
                  </button>
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="home-grid">
          {
            sections.map((section, index) => (
              <HomeSection
                section={section}
                index={index}
                locale={locale}
                href={getHomeSectionHref(section, locale, getLocalizedPath)}
              />
            ))
          }
        </div>
        <script is:inline define:vars={{ restoreKey: HOME_SCROLL_RESTORE_KEY }}>
          try {
            const raw = sessionStorage.getItem(restoreKey);

            if (raw) {
              const pending = JSON.parse(raw);

              if (typeof pending.homeSectionIndex === 'number') {
                const index = pending.homeSectionIndex;
                const section = document.querySelector('[data-home-section="' + index + '"]');

                if (section) {
                  document.querySelectorAll('[data-home-section]').forEach((entry) => {
                    entry.classList.toggle('is-active', entry === section);
                  });

                  document.querySelectorAll('[data-home-section-nav]').forEach((button) => {
                    const navIndex = Number(button.getAttribute('data-home-section-nav'));
                    const isActive = navIndex === index;

                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-current', isActive ? 'true' : 'false');
                  });

                  section.scrollIntoView({ block: 'center', behavior: 'instant' });
                }
              }
            }
          } catch {
            // sessionStorage unavailable
          }
        </script>
      </>
    )
  }
</Layout>

<script>
  import { initHomeHoverState } from '../lib/home-hover';
  import { initHomeScrollState } from '../lib/home-scroll';

  initHomeScrollState();
  initHomeHoverState();
</script>
