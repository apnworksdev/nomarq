---
import { getRelativeLocaleUrl } from 'astro:i18n';

import EntryDetailPage from '../components/EntryDetailPage.astro';
import type { Locale } from '../lib/i18n';
import { defaultLocale } from '../lib/i18n';
import { projectBySlugQuery, type Project } from '../lib/queries';
import { sanity } from '../lib/sanity';
import { getUi } from '../lib/ui';
import { getUseTitle } from '../lib/use';
import { formatYear } from '../lib/year';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const copy = getUi(locale);

const project = await sanity.fetch<Project | null>(projectBySlugQuery, {
  slug,
  language: locale,
  defaultLanguage: defaultLocale,
});

if (!project) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/projects'));
}

const deeperSections = (project.deeperSections ?? [])
  .map((section) => ({
    name: section.name?.trim() ?? '',
    images: (section.images ?? []).filter((image) => image.image),
  }))
  .filter((section) => section.name && section.images.length > 0);

if (deeperSections.length === 0) {
  return Astro.redirect(getRelativeLocaleUrl(locale, `/projects/${slug}`));
}

const place = project.location?.place?.trim() || undefined;
const country =
  project.location?.country?.short?.trim() ||
  project.location?.country?.full?.trim() ||
  undefined;
const images = (project.images ?? []).filter((image) => image.image);
const locationLabel = [place, project.location?.country?.full?.trim()]
  .filter(Boolean)
  .join('\n');
const useLabel = (project.use ?? [])
  .map((item) => getUseTitle(item, locale).trim())
  .filter(Boolean)
  .join(', ');

const technicalRows = [
  { label: copy.technicalInfo.location, value: locationLabel },
  { label: copy.technicalInfo.use, value: useLabel },
  { label: copy.technicalInfo.year, value: formatYear(project.year) },
  { label: copy.technicalInfo.collaborators, value: project.collaborators?.trim() },
  { label: copy.technicalInfo.photography, value: project.photography?.trim() },
].filter((row) => Boolean(row.value));

const privDescription =
  project.deeperDescription?.trim() || project.description?.trim() || undefined;
const publicHref = getRelativeLocaleUrl(locale, `/projects/${slug}`);
const privHref = getRelativeLocaleUrl(locale, `/projects/${slug}/priv`);
---

<EntryDetailPage
  pageTitle={`${project.title} — Nomarq`}
  variant="priv"
  images={images}
  technicalRows={technicalRows}
  technicalTitle={copy.technicalInfo.title}
  entryTitle={project.title}
  sectionTypeLabel={`(${copy.nav.projects})`}
  informationLabel={copy.information}
  captionPlace={place}
  captionCountry={country}
  description={privDescription}
  relatedEntries={[]}
  relatedHeading={copy.relatedProjects}
  deeperSections={deeperSections}
  deeperCopy={copy.deeper}
  privHref={privHref}
  publicHref={publicHref}
  locale={locale}
/>
