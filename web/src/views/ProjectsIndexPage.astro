---
import ProjectsFilters from '../components/ProjectsFilters.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import ProjectsList from '../components/ProjectsList.astro';
import type { Locale } from '../lib/i18n';
import { defaultLocale } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import { projectsQuery, usesQuery, type Project, type UseDocument } from '../lib/queries';
import { sanity } from '../lib/sanity';
import { getUi } from '../lib/ui';
import '../styles/pages/projects-index.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale);

const [projects, uses] = await Promise.all([
  sanity.fetch<Project[]>(projectsQuery, { language: locale, defaultLanguage: defaultLocale }),
  sanity.fetch<UseDocument[]>(usesQuery),
]);

const listProjects = projects;
const gridProjects = listProjects.filter(
  (project) => project.selected !== false && (project.images ?? []).some((image) => image.image),
);
---

<Layout title={`${copy.nav.projects} — Nomarq`} page="projects">
  <ProjectsFilters projects={listProjects} uses={uses} locale={locale} />
  {
    listProjects.length === 0 ? (
      <p class="projects-empty">{copy.noProjects}</p>
    ) : (
      <>
        <ProjectsGrid projects={gridProjects} locale={locale} />
        <ProjectsList projects={listProjects} locale={locale} />
      </>
    )
  }
</Layout>

<script>
  import { initProjectsGridHoverState } from '../lib/projects-grid-hover';
  import { initProjectsListHoverState } from '../lib/projects-list-hover';

  initProjectsGridHoverState();
  initProjectsListHoverState();
</script>

<style>
  .projects-empty {
    padding: var(--margin);
    padding-top: var(--header-offset);
  }
</style>
