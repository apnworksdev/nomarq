---
import type { AboutJournalEntry } from '../lib/about';
import type { Locale } from '../lib/i18n';
import { responsiveImage } from '../lib/image';
import { getJournalCategoryDisplayLabel, getJournalEntryHref, isExternalHref } from '../lib/journal';
import { getJournalCategoryLabel } from '../lib/ui';

interface Props {
  entry: AboutJournalEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const href = getJournalEntryHref(locale, entry);
const external = href ? isExternalHref(href) : false;
const coverImage = entry.coverImage?.image;
---

<li class="about-list-item" data-about-list-item>
  {
    href ? (
      <a
        class="about-list-item-link"
        href={href}
        data-about-list-link
        {...(external
          ? { target: '_blank', rel: 'noopener noreferrer' }
          : { 'data-entry-close-link': true, 'data-entry-close-origin': 'about' })}
      >
        <span class="about-list-item-label">
          <span class="about-list-item-category">
            {getJournalCategoryDisplayLabel(locale, entry, getJournalCategoryLabel)}
          </span>
          <span class="about-list-item-title">{entry.title}</span>
        </span>
        {entry.year && <span class="about-list-item-meta">{entry.year}</span>}
      </a>
    ) : (
      <span class="about-list-item-link" data-about-list-link>
        <span class="about-list-item-label">
          <span class="about-list-item-category">
            {getJournalCategoryDisplayLabel(locale, entry, getJournalCategoryLabel)}
          </span>
          <span class="about-list-item-title">{entry.title}</span>
        </span>
        {entry.year && <span class="about-list-item-meta">{entry.year}</span>}
      </span>
    )
  }
  {
    coverImage && (
      <div class="about-list-thumb" aria-hidden="true">
        <img
          {...responsiveImage(coverImage, [800, 1400], '25vw')}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</li>
