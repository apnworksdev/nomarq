---
import EntryCaption from './EntryCaption.astro';
import EntryGallery from './EntryGallery.astro';
import {
  formatHomeSectionCaption,
  getHomeSectionCover,
  getHomeSectionImages,
  getHomeSectionItem,
  getHomeSectionLinkLabel,
  isExternalHomeLink,
  isHomeSectionExpandable,
  resolveStartingColumn,
  type HomeSection,
} from '../lib/home';
import type { Locale } from '../lib/i18n';

interface Props {
  section: HomeSection;
  href?: string;
  index: number;
  locale: Locale;
}

const { section, href, index, locale } = Astro.props;
const item = getHomeSectionItem(section);

if (!item) {
  return null;
}

const caption = formatHomeSectionCaption(section, locale);
const linkLabel = getHomeSectionLinkLabel(section, locale);
const external = isExternalHomeLink(href);
const closeLinkProps =
  href && !external ? { 'data-entry-close-link': true, 'data-entry-close-origin': 'home' } : {};
const linkProps = href
  ? external
    ? { target: '_blank', rel: 'noopener noreferrer' }
    : closeLinkProps
  : {};
const startingColumn = resolveStartingColumn(section);
const layoutClass =
  section.sectionType === 'project' && section.layout
    ? `home-section--${section.layout}`
    : section.sectionType === 'journal'
      ? 'home-section--journal'
      : undefined;
const cover = getHomeSectionCover(item);
const allImages = getHomeSectionImages(item).filter((image) => image.image);
const expandable = isHomeSectionExpandable(item);
const galleryImages = cover?.image ? allImages : [];
---

<article
  class:list={['home-section', layoutClass, { 'is-active': index === 0 }]}
  style={startingColumn ? { '--home-start-column': startingColumn } : undefined}
  data-section-type={section.sectionType}
  data-home-section={index}
  data-home-section-expandable={expandable ? 'true' : 'false'}
>
  {
    galleryImages.length > 0 && (
      <div data-home-section-cover>
        <EntryGallery
          images={galleryImages}
          title={item.title}
          loading={index === 0 ? 'eager' : 'lazy'}
          mode="cover"
        />
      </div>
    )
  }

  <div class="entry-overlay entry-layout-overlay entry-layout-overlay--fixed" data-home-section-overlay-text>
    {
      caption.type.length > 0 && (
        <div class="entry-overlay-type">
          {caption.type.map((label) => (
            <p class="entry-overlay-type-label">{label}</p>
          ))}
        </div>
      )
    }

    <p class="entry-overlay-detail entry-layout-detail">
      {
        href ? (
          <a class="entry-overlay-detail-link entry-overlay-detail-trigger" href={href} {...linkProps}>
            <EntryCaption title={caption.title} place={caption.place} country={caption.country} />
          </a>
        ) : (
          <span class="entry-overlay-detail-trigger">
            <EntryCaption title={caption.title} place={caption.place} country={caption.country} />
          </span>
        )
      }
      {
        item.shortDescription && (
          <span class="entry-overlay-description">{item.shortDescription}</span>
        )
      }
    </p>

    {
      href && (
        <a class="entry-overlay-link" href={href} {...linkProps}>
          {linkLabel}
        </a>
      )
    }
  </div>

  {
    expandable && galleryImages.length > 1 && (
      <div
        class="home-section-overlay home-section-overlay--media entry-gallery-overlay entry-gallery-overlay--fixed"
        data-home-section-overlay-media
        data-home-section-expanded
      >
        <EntryGallery images={galleryImages} title={item.title} mode="strip" />
      </div>
    )
  }
</article>
