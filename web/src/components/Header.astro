---
import { getRelativeLocaleUrl } from 'astro:i18n';

import {
  getLocaleFromPath,
  getLocalizedPath,
  isAboutJournalPath,
  isEntryDetailPath,
  isJournalDetailPath,
  isProjectsIndexPath,
  locales,
  matchNavId,
  navItems,
  stripLocaleFromPath,
  type Locale,
} from '../lib/i18n';
import {
  getJournalSectionFromPath,
  getJournalSectionPath,
} from '../lib/journal';
import { getNavLabel, getUi } from '../lib/ui';
import '../styles/components/header.css';

const pathname = Astro.url.pathname;
const locale = getLocaleFromPath(pathname) as Locale;
const activeNavId = matchNavId(pathname);
const pathWithoutLocale = stripLocaleFromPath(pathname);
const isProjectsIndex = isProjectsIndexPath(pathname);
const isAboutJournal = isAboutJournalPath(pathname);
const isEntryDetail = isEntryDetailPath(pathname);
const entryDetailType = isJournalDetailPath(pathname) ? 'journal' : 'project';
const showFilters = isProjectsIndex || isAboutJournal;
const copy = getUi(locale);
const journalClosePath = getJournalSectionPath(
  getJournalSectionFromPath(pathname) ?? 'recognition',
);
const closeHref = getLocalizedPath(
  locale,
  entryDetailType === 'journal' ? journalClosePath : '/projects',
);
---

<header class="header" transition:persist="site-header">
  <button
    type="button"
    class="header-menu-toggle"
    data-mobile-menu-toggle
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <span data-mobile-menu-toggle-label>{copy.menu}</span>
  </button>

  <nav class="header-nav" id="mobile-menu" data-mobile-menu aria-label={locale === 'es' ? 'Principal' : 'Main'}>
    <button
      type="button"
      class="header-menu-close"
      data-mobile-menu-close
    >
      <span data-mobile-menu-close-label>{copy.close}</span><span aria-hidden="true"> ( X )</span>
    </button>

    <div class="header-nav-start">
      <menu class="header-nav-menu-left">
        {
          navItems.left.map((item) => (
            <li class="header-nav-menu-item">
              <a
                href={getRelativeLocaleUrl(locale, item.href)}
                data-nav={item.id}
                class:list={['active-parens', { active: activeNavId === item.id }]}
              >
                {getNavLabel(locale, item.id)}
              </a>
            </li>
          ))
        }
      </menu>
      <span
        class="header-nav-view-switch"
        data-projects-view-switch
        hidden={!isProjectsIndex}
      >
        <button
          type="button"
          class="active-parens"
          data-projects-view="grid"
        >
          {copy.projectsView.grid}
        </button>
        <button
          type="button"
          class="active-parens"
          data-projects-view="list"
        >
          {copy.projectsView.list}
        </button>
      </span>
    </div>

    <div class="header-nav-filter">
      <button
        type="button"
        class="header-nav-filter-toggle"
        data-projects-filter-toggle
        aria-expanded="false"
        aria-controls={isAboutJournal ? 'journal-filters-panel' : 'projects-filters-panel'}
        hidden={!showFilters}
      >
        <span data-projects-filter-toggle-label>{copy.projectsFilters.toggle}</span>
        <span data-projects-filter-toggle-sign aria-hidden="true">( + )</span>
      </button>
    </div>

    <menu class="header-nav-menu-right">
      {
        navItems.right.map((item) => (
          <li class="header-nav-menu-item">
            <a
              href={getRelativeLocaleUrl(locale, item.href)}
              data-nav={item.id}
              class:list={['active-parens', { active: activeNavId === item.id }]}
            >
              {getNavLabel(locale, item.id)}
            </a>
          </li>
        ))
      }
    </menu>
  </nav>

  <div class="header-logo">
    <h2 class="header-logo-text">
      <a href={getRelativeLocaleUrl(locale, '/')} data-header-logo>nomarq</a>
    </h2>
  </div>

  <div class="header-language-switcher">
    <a
      href={closeHref}
      class="header-close active-parens"
      data-header-close
      data-entry-detail-type={entryDetailType}
      hidden={!isEntryDetail}
      aria-label={copy.close}
    >
      <span data-header-close-label>{copy.close}</span><span aria-hidden="true"> ( X )</span>
    </a>
    <span class="header-language-switcher-locales" hidden={isEntryDetail}>
      {
        locales.map((lang) => (
          <a
            href={getRelativeLocaleUrl(lang, pathWithoutLocale)}
            data-locale-switcher={lang}
            class:list={['active-parens', { active: locale === lang }]}
            aria-current={locale === lang ? 'true' : undefined}
            hreflang={lang}
            lang={lang}
          >
            {lang.toUpperCase()}
          </a>
        ))
      }
    </span>
  </div>
</header>

<script>
  import { initNavActiveState } from '../lib/nav-active';

  initNavActiveState();
</script>
