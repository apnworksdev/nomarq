---
import EntryCaption from './EntryCaption.astro';
import { imageAlt } from '../lib/alt';
import type { RelatedEntryItem } from '../lib/entry-detail';
import { responsiveImage } from '../lib/image';

interface Props {
  entries: RelatedEntryItem[];
  heading: string;
  titleId?: string;
}

const { entries, heading, titleId = 'related-entries-title' } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="project-related" aria-labelledby={titleId}>
      <h2 id={titleId} class="project-related-title">( {heading} )</h2>
      <ul class="project-related-list">
        {
          entries.map((entry) => (
            <li class="project-related-item">
              <a class="project-related-link" href={entry.href}>
                {
                  entry.coverImage?.image && (
                    <figure class="project-related-media">
                      <img
                        {...responsiveImage(entry.coverImage.image, [1000, 1800], '(max-width: 820px) 100vw, 30vw')}
                        alt={imageAlt(entry.coverImage.alt, entry.title)}
                        loading="lazy"
                      />
                    </figure>
                  )
                }
                <p class="project-related-caption">
                  <EntryCaption
                    title={entry.title}
                    place={entry.place}
                    country={entry.country}
                  />
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )
}
