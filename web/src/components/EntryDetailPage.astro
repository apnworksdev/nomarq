---
import EntryCaption from './EntryCaption.astro';
import EntryGallery from './EntryGallery.astro';
import ProjectDeeper from './ProjectDeeper.astro';
import RelatedEntries from './RelatedEntries.astro';

import type { RelatedEntryItem, TechnicalRow } from '../lib/entry-detail';
import { splitParagraphs } from '../lib/entry-detail';
import type { DeeperSection, ImageField } from '../lib/queries/shared';
import type { UiCopy } from '../lib/ui';
import Layout from '../layouts/Layout.astro';
import '../styles/components/entry-caption.css';
import '../styles/components/entry-gallery.css';
import '../styles/components/project-related.css';
import '../styles/pages/project.css';

interface Props {
  pageTitle: string;
  images: ImageField[];
  technicalRows: TechnicalRow[];
  technicalTitle: string;
  entryTitle: string;
  entryKind?: 'project' | 'journal';
  variant?: 'public' | 'priv';
  sectionTypeLabel?: string;
  informationLabel: string;
  captionPlace?: string;
  captionCountry?: string;
  description?: string;
  relatedEntries: RelatedEntryItem[];
  relatedHeading: string;
  relatedTitleId?: string;
  deeperSections?: DeeperSection[];
  deeperCopy?: UiCopy['deeper'];
  privHref?: string;
  publicHref?: string;
  locale?: 'en' | 'es';
}

const {
  pageTitle,
  images,
  technicalRows,
  technicalTitle,
  entryTitle,
  entryKind = 'project',
  variant = 'public',
  sectionTypeLabel,
  informationLabel,
  captionPlace,
  captionCountry,
  description,
  relatedEntries,
  relatedHeading,
  relatedTitleId,
  deeperSections = [],
  deeperCopy,
  privHref,
  publicHref,
  locale = 'en',
} = Astro.props;

const isPriv = variant === 'priv';
const hasStrip = !isPriv && images.length > 1;
const descriptionParagraphs = description ? splitParagraphs(description) : [];
const preparedDeeperSections = deeperSections
  .map((section) => ({
    ...section,
    images: (section.images ?? []).filter((image) => image.image),
  }))
  .filter((section) => section.name.trim() && section.images.length > 0);
const hasDeeper = preparedDeeperSections.length > 0 && Boolean(deeperCopy);
const showAccessForm = !isPriv && hasDeeper && Boolean(privHref);
const showPrivPanel = isPriv && hasDeeper;
const hasInfo = technicalRows.length > 0 || Boolean(description) || showAccessForm || showPrivPanel;
---

<Layout title={pageTitle} page="project">
  <article
    class:list={['project-hero', { 'is-priv': isPriv }]}
    data-entry-detail
    data-entry-gallery-root={!isPriv ? '' : undefined}
    data-entry-kind={entryKind}
    data-project-variant={variant}
  >
    {
      !isPriv && images.length > 0 && (
        <div class="project-media project-media--public">
          <EntryGallery
            images={images}
            title={entryTitle}
            loading="eager"
            mode="cover"
            showCounter={hasStrip}
          />
        </div>
      )
    }

    {
      isPriv && hasDeeper && deeperCopy && (
        <ProjectDeeper
          sections={preparedDeeperSections}
          entryTitle={entryTitle}
          copy={deeperCopy}
          mode="media"
        />
      )
    }

    {
      hasStrip && (
        <div class="entry-gallery-overlay entry-gallery-overlay--anchored">
          <EntryGallery images={images} title={entryTitle} mode="strip" interactive />
        </div>
      )
    }

    {
      (technicalRows.length > 0 || showAccessForm || showPrivPanel) && (
        <section class="project-technical" aria-label={technicalTitle}>
          <div class="project-technical-inner">
            {
              technicalRows.length > 0 && (
                <div class="project-technical-main">
                  <h2 id="entry-technical-title" class="project-technical-title">
                    {technicalTitle}
                  </h2>
                  <dl class="project-technical-list">
                    {
                      technicalRows.map((row) => (
                        <div class="project-technical-row">
                          <dt>{row.label}</dt>
                          <dd>{row.value}</dd>
                        </div>
                      ))
                    }
                  </dl>
                </div>
              )
            }

            {
              showAccessForm && deeperCopy && privHref && (
                <ProjectDeeper
                  sections={preparedDeeperSections}
                  entryTitle={entryTitle}
                  copy={deeperCopy}
                  mode="access"
                  privHref={privHref}
                  locale={locale}
                />
              )
            }

            {
              showPrivPanel && deeperCopy && (
                <ProjectDeeper
                  sections={preparedDeeperSections}
                  entryTitle={entryTitle}
                  copy={deeperCopy}
                  mode="sections"
                  privHref={privHref}
                  publicHref={publicHref}
                  locale={locale}
                />
              )
            }
          </div>
        </section>
      )
    }

    <div class="entry-overlay entry-layout-overlay entry-layout-overlay--anchored is-expanded project-detail">
      {
        sectionTypeLabel && (
          <div class="entry-overlay-type">
            <p class="entry-overlay-type-label">{sectionTypeLabel}</p>
          </div>
        )
      }

      <div class="entry-overlay-detail entry-layout-detail">
        <span class="entry-overlay-detail-trigger">
          <EntryCaption title={entryTitle} place={captionPlace} country={captionCountry} />
        </span>
        {
          descriptionParagraphs.length > 0 && (
            <div class="entry-overlay-description">
              {
                descriptionParagraphs.map((paragraph) => (
                  <p class="entry-overlay-description-paragraph">{paragraph}</p>
                ))
              }
            </div>
          )
        }
      </div>

      {
        hasInfo && (
          <button
            type="button"
            class="entry-info-toggle"
            data-entry-info-toggle
            aria-expanded="false"
          >
            <span data-entry-info-toggle-label>{informationLabel}</span>
            <span data-entry-info-toggle-sign aria-hidden="true">( + )</span>
          </button>
        )
      }
    </div>
  </article>

  {
    !isPriv && (
      <RelatedEntries
        entries={relatedEntries}
        heading={relatedHeading}
        titleId={relatedTitleId}
      />
    )
  }
</Layout>

<script>
  import { initEntryGalleryState } from '../lib/entry-gallery';
  import { initEntryInfoState } from '../lib/entry-info';
  import { initProjectDeeperState } from '../lib/project-deeper';

  initEntryGalleryState();
  initEntryInfoState();
  initProjectDeeperState();
</script>
