---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { imageAlt } from '../lib/alt';
import type { Locale } from '../lib/i18n';
import { responsiveImage } from '../lib/image';
import { buildProjectsGridLayout } from '../lib/projects-grid';
import type { Project } from '../lib/queries';
import EntryCaption from './EntryCaption.astro';

interface Props {
  projects: Project[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const items = buildProjectsGridLayout(projects);
---

<div class="projects-grid" data-projects-grid>
  {
    items.map((item) => (
      <>
        <article
          class="projects-grid-item"
          style={{
            gridRow: item.row,
            gridColumn: `${item.startColumn} / span ${item.span}`,
          }}
          data-projects-grid-item
          data-project-slug={item.slug}
        >
          <a
            href={getRelativeLocaleUrl(locale, `/projects/${item.slug}`)}
            class="projects-grid-main"
            data-projects-grid-main
            data-entry-close-link
            data-entry-close-origin="projects"
          >
            {
              item.coverImage.image && (
                <img
                  {...responsiveImage(item.coverImage.image, [1200, 2000, 2800], '(max-width: 820px) 100vw, 45vw')}
                  alt={imageAlt(item.coverImage.alt, item.title)}
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </a>
          <div class="projects-grid-caption">
            <EntryCaption title={item.title} place={item.place} country={item.country} />
          </div>
        </article>
        {
          item.previews.map((preview) =>
            preview.image.image ? (
              <div
                class="projects-grid-preview"
                style={{
                  gridRow: item.row,
                  gridColumn: `${preview.column} / span 1`,
                  '--preview-index': preview.imageIndex - 1,
                }}
                data-projects-grid-preview
                data-project-slug={item.slug}
                data-preview-index={preview.imageIndex}
              >
                <img
                  {...responsiveImage(preview.image.image, [800, 1400], '(max-width: 820px) 50vw, 20vw')}
                  alt={imageAlt(preview.image.alt, item.title, { index: preview.imageIndex })}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : null,
          )
        }
      </>
    ))
  }
</div>
