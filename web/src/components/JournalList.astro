---
import InlineText from './InlineText.astro';
import type { JournalEntry, JournalSection } from '../lib/journal';
import { getJournalCategoryDisplayLabel, getJournalEntryHref, isExternalHref } from '../lib/journal';
import type { Locale } from '../lib/i18n';
import { responsiveImage } from '../lib/image';
import { getJournalCategoryLabel } from '../lib/ui';
import '../styles/components/projects-list.css';

interface Props {
  entries: JournalEntry[];
  locale: Locale;
  section: JournalSection;
}

const { entries, locale, section } = Astro.props;
---

<ol class="projects-list" data-journal-list>
  {
    entries.map((entry, index) => {
      const coverImage = (entry.images ?? []).find((image) => image.image);
      const description = entry.description?.trim() ?? '';
      const categoryLabel = getJournalCategoryDisplayLabel(locale, entry, getJournalCategoryLabel);
      const entryId = entry._id;
      const href = getJournalEntryHref(locale, entry);
      const external = href ? isExternalHref(href) : false;

      return (
        <li
          class="projects-list-item"
          data-journal-list-item
          data-journal-id={entryId}
        >
          {
            coverImage?.image && (
              <div class="projects-list-thumb" aria-hidden="true">
                <img
                  {...responsiveImage(coverImage.image, [800, 1400], '25vw')}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )
          }
          <span class="projects-list-index" data-journal-list-index>
            ( {index + 1} )
          </span>
          {
            href ? (
              <a
                href={href}
                class="projects-list-title"
                data-journal-list-title
                {...(external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : { 'data-entry-close-link': true, 'data-entry-close-origin': section })}
              >
                {entry.title}
              </a>
            ) : (
              <span class="projects-list-title" data-journal-list-title>
                {entry.title}
              </span>
            )
          }
          <div class="projects-list-location">
            <span class="projects-list-location-place">( {categoryLabel} )</span>
          </div>
          {entry.year ? (
            <span class="projects-list-year">{entry.year}</span>
          ) : (
            <span class="projects-list-year" aria-hidden="true"></span>
          )}
          {
            description && (
              <p class="projects-list-description" data-journal-list-description>
                <InlineText text={description} />
              </p>
            )
          }
        </li>
      );
    })
  }
</ol>
