---
import { getJournalStaticPaths } from '../../../lib/static-paths';
import JournalDetailPage from '../../../views/JournalDetailPage.astro';

export async function getStaticPaths() {
  return getJournalStaticPaths('en', 'initiatives');
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/about/initiatives');
}
---

<JournalDetailPage locale="en" slug={slug} section="initiatives" />
