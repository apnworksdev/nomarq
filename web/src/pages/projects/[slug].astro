---
import { getProjectStaticPaths } from '../../lib/static-paths';
import ProjectDetailPage from '../../views/ProjectDetailPage.astro';

export async function getStaticPaths() {
  return getProjectStaticPaths('en');
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/projects');
}
---

<ProjectDetailPage locale="en" slug={slug} />
