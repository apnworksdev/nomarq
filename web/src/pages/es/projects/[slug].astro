---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { fetchProjectBySlug } from '../../../lib/load-project';
import ProjectDetailPage from '../../../views/ProjectDetailPage.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/es/projects');
}

const project = await fetchProjectBySlug(slug, 'es');

if (!project) {
  return Astro.redirect(getRelativeLocaleUrl('es', '/projects'));
}
---

<ProjectDetailPage locale="es" slug={slug} project={project} />
