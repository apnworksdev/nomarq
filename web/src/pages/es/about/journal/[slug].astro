---
import { getJournalStaticPaths } from '../../../../lib/static-paths';
import JournalDetailPage from '../../../../views/JournalDetailPage.astro';

export async function getStaticPaths() {
  return getJournalStaticPaths('es');
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/es/about/journal');
}
---

<JournalDetailPage locale="es" slug={slug} />
