---
import { ClientRouter } from 'astro:transitions';

import '../styles/index.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { HOME_SCROLL_RESTORE_KEY } from '../lib/home-scroll';
import { getLocaleFromPath } from '../lib/i18n';

interface Props {
  title: string;
  page: 'home' | 'projects' | 'project' | 'about';
}

const { title, page } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const view = localStorage.getItem('nomarq-projects-view');

        if (view === 'grid' || view === 'list') {
          document.documentElement.dataset.projectsView = view;
        }
      } catch {
        // localStorage unavailable
      }
    </script>
    {
      page === 'home' && (
        <script is:inline define:vars={{ restoreKey: HOME_SCROLL_RESTORE_KEY }}>
          try {
            const raw = sessionStorage.getItem(restoreKey);

            if (raw) {
              const pending = JSON.parse(raw);
              const root = document.documentElement;

              root.dataset.homeScrollRestore = 'true';

              if (typeof pending.scrollY === 'number') {
                window.scrollTo(0, pending.scrollY);
              }
            }
          } catch {
            // sessionStorage unavailable
          }
        </script>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { initEntryCloseState } from '../lib/entry-close';
  import { initJournalFiltersState } from '../lib/journal-filter';
  import { initMobileMenu } from '../lib/mobile-menu';
  import { initProjectsFiltersState } from '../lib/projects-filter';
  import { initProjectsViewState } from '../lib/projects-view';

  initMobileMenu();
  initProjectsFiltersState();
  initJournalFiltersState();
  initProjectsViewState();
  initEntryCloseState();
</script>
